#!/usr/bin/env bash
# Pre-commit gate for singlecell_factory.
#
# Stage 1: reference manager — keeps README citation list in sync with
#          module-level __references__ blocks. Blocks if README.md is mutated.
#
# Stage 2: repo-doc-sync drift detector — fails if README + agent-facing
#          docs drift from current canonical state (latest run dir, latest
#          ledger, latest audit doc, missing DOIs, stale Current State block,
#          missing v1 do-not-cite when v2 exists). Bypass with --no-verify.
#
# Activate via:  git config core.hooksPath .githooks

set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "[pre-commit] Running reference manager..."
python3 scripts/update_references.py
if git diff --name-only | grep -q '^README\.md$'; then
    echo "[pre-commit] README.md citation list was updated. Stage README.md and re-commit."
    exit 1
fi
echo "[pre-commit] References check passed."

DETECTOR="$HOME/.claude/skills/repo-doc-sync/scripts/sync_repo_docs.py"
if [[ -f "$DETECTOR" ]]; then
    echo "[pre-commit] Running repo-doc-sync drift detector..."
    if ! python3 "$DETECTOR" --repo "$REPO_ROOT" --strict; then
        echo "[pre-commit] Doc drift detected. Run with --report to see findings, fix, and re-commit."
        echo "[pre-commit] Bypass: git commit --no-verify  (only when you accept the drift)."
        exit 1
    fi
    echo "[pre-commit] Doc-sync drift gate passed."
else
    echo "[pre-commit] WARN: repo-doc-sync skill not installed at $DETECTOR — skipping drift gate."
fi

exit 0
